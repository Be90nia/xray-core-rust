# Build
/target
# 并行代理的独立编译目录（CARGO_TARGET_DIR=target-<agent>）：只写 /target 会漏掉兄弟目录，
# 而 /target-*/ 每个可达数十 GB，一次 git add -A 即事故。2026-11-01 卫生审计发现。
/target-*/
**/*.rs.bk
*.pdb
/target-fv/
__pycache__/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Beads / Dolt files
.dolt/
*.db
.beads-credential-key
.beads/

# Graphify
graphify-out/

# codebase-memory (MCP 知识图谱 artifact, 本地生成不提交)
.codebase-memory/

# Coverage
coverage/
*.profraw
*.profdata

# Environment
.env
.env.local

# OMO internal
.omo/
# Local Pi runtime state
.atl/

# Beads / Dolt files (added by bd init)
.beads/proxieddb/
*.gate.lock*

# Cargo user-level config (本机性能调优如 target-cpu=native 不该污染跨机器发行)
# 2026-09-20 cleanup: .cargo/config.toml 从历史抹除后兜底,避免误跟踪
/.cargo/


